# Logs
logs
*.log
npm-debug.log*

node_modules
dist
*.local

# Secrets: keys live in .env locally and in hPanel on Hostinger, never in git
.env
.env.*
!.env.example

# Caches written by the data bakers
scripts/.cache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Security-test accounts (secrets, never commit)
tests/security/accounts.local.json

# Video projects: keep the sources, not what renders and previews rebuild
videos/*/renders/
videos/*/renders-log.txt
videos/*/snapshots/
videos/*/.thumbnails/
videos/*/.waveform-cache/

# Vector tiles built by scripts/build-tiles.mjs: hundreds of megabytes, rebuilt from OpenStreetMap
tiles/
# Valhalla's road graph (scripts/build-valhalla.mjs).
valhalla/
# The roads lane by lane are built from (scripts/extract-roads.mjs), cut into squares.
/roads/

# The mark the edit hook leaves for the check at the end of a turn (.claude/hooks).
.claude/.edited
