{
  "name": "project-white-hornet",
  "private": true,
  "version": "0.1.0",
  "description": "Latvia OSINT world-view dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build && vite build --config vite.server.config.ts && node scripts/postbuild.mjs",
    "start": "node dist/server/index.js",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "h3-js": "^4.5.0",
    "hono": "^4.13.13",
    "maplibre-gl": "6.12.0",
    "mgrs": "^2.2.0",
    "pbf": "^5.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satellite.js": "7.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mapshaper": "^0.7.78",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
